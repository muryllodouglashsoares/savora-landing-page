# URL do "Custom Webhook" criado no Make (Webhooks > Custom webhook).
# O formulário de Reservas envia os dados para essa URL via POST.
#
# Para desenvolvimento local: copie este arquivo para .env.local e cole a URL
# real (o .env.local já está no .gitignore, então não vai parar no git).
#
# Para produção (Cloudflare Workers): defina a mesma variável nas
# configurações do Worker (Settings > Variables) ou via `wrangler secret put`.
VITE_RESERVATION_WEBHOOK_URL=https://hook.us1.make.com/xxxxxxxxxxxxxxxxxxxxxxxx
